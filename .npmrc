package-manager-strict=false
auto-install-peers=true

# Allow native build scripts for essential packages
# Without these, sharp (image processing), esbuild (bundler), 
# @tailwindcss/oxide (CSS engine), and crypto libs won't compile
allowedDeprecatedVersions[*]=*
supportedArchitectures[os][]=current
supportedArchitectures[cpu][]=current

# pnpm v9+ blocks postinstall scripts by default for security
# These packages MUST run their build scripts to function
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@tailwindcss/oxide
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=protobufjs
onlyBuiltDependencies[]=secp256k1
onlyBuiltDependencies[]=keccak
onlyBuiltDependencies[]=bigint-buffer
onlyBuiltDependencies[]=bufferutil
onlyBuiltDependencies[]=utf-8-validate
onlyBuiltDependencies[]=aws-sdk
